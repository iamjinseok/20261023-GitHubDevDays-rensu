---
import type { Category, Publisher } from '../types/game';
import Button from './Button.astro';

interface Props {
    categories: Category[];
    publishers: Publisher[];
    total: number;
}

const { categories, publishers, total } = Astro.props;
---

<form
    class="mb-6 bg-slate-800/60 backdrop-blur-sm rounded-xl border border-slate-700/50 p-5 flex flex-col gap-5 md:flex-row md:items-end md:justify-between"
    data-testid="game-filters"
    data-total={total}
    aria-label="Filter games"
>
    <fieldset class="min-w-0" data-testid="filter-categories">
        <legend class="text-sm font-medium text-slate-200 mb-2">Category</legend>
        <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/50 px-3 py-1.5 text-sm text-slate-200 cursor-pointer hover:bg-slate-700 transition-colors duration-200 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500 has-[:checked]:border-blue-500 has-[:checked]:text-blue-300">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 accent-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-col gap-2 md:w-64">
        <label for="publisher-filter" class="text-sm font-medium text-slate-200">Publisher</label>
        <select
            id="publisher-filter"
            name="publisher"
            class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-publisher"
        >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
        </select>
    </div>

    <Button size="sm" data-filter-reset data-testid="filter-reset">Clear filters</Button>
</form>

<p class="sr-only" role="status" aria-live="polite" data-testid="filter-status"></p>

<script>
    import { matchesFilters } from '../lib/filters';

    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(
        document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'),
    );
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty"]');
    const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
    const publisherSelect = document.querySelector<HTMLSelectElement>(
        '[data-testid="filter-publisher"]',
    );

    const toId = (value: string | undefined): number | null =>
        value ? Number(value) : null;

    function applyFilters(): void {
        if (!form || !publisherSelect) return;

        const categoryIds = Array.from(
            form.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'),
        ).map((input) => Number(input.value));
        const criteria = { categoryIds, publisherId: toId(publisherSelect.value) };

        let visible = 0;
        for (const card of cards) {
            const show = matchesFilters(
                {
                    categoryId: toId(card.dataset.categoryId),
                    publisherId: toId(card.dataset.publisherId),
                },
                criteria,
            );
            card.hidden = !show;
            if (show) visible++;
        }

        if (emptyState) emptyState.hidden = visible !== 0;
        if (status) {
            status.textContent =
                visible === 0
                    ? 'No games match your filters.'
                    : `Showing ${visible} of ${cards.length} games.`;
        }
    }

    function resetFilters(): void {
        form?.reset();
        applyFilters();
    }

    form?.addEventListener('change', applyFilters);
    form?.addEventListener('submit', (event) => event.preventDefault());
    document.querySelectorAll('[data-filter-reset]').forEach((button) => {
        button.addEventListener('click', resetFilters);
    });
    // Restore state after a back/forward navigation or browser form restoration.
    applyFilters();
</script>
